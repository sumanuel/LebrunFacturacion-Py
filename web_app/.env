# Configuración de desarrollo para Lebrun Facturación Web
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Base de datos (configurar según tu instalación MySQL)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=sysconf
MYSQL_PORT=3306

# Clave secreta para desarrollo
SECRET_KEY=dev-secret-key-change-in-production-2024

# Configuración de logging
LOG_LEVEL=INFO